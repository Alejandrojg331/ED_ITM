Clase ManejoCola

  publico Cola IngresarDatos (Cola objC)
    Objeto Info
    entero resp
    entero cod
    Estudiante objE = nuevo Estudiante()
    imprimir("Desea ingresar un estudiante a la cola:  1. Si   2. No\n ")
    lea resp
    mientras(resp==1)haga
     imprimir(" ingrese el código del nuevo estudiante: ")
     lea cod
     si(Buscar(objPila,objPAux, cod)==falso)entonces
      Estudiante objE = new Estudiante()
      objE=objE.lecturaDatos(cod)
      objC.Push(objE)
      sino
        imprimir("Estudiante ya existe en la pila \n")
     Fin_Si
     Imprimir("Desea ingresar otro Estudiante a la Cola? 1. Sí   2. No")
     lea resp
    Fin_Mientras
    retornar objC
   FinMetodo


  publico cadena Imprimir(Cola objc,Cola objca)
   cadena Texto=""
   Objeto Info
   mientras(objc.IsEmpty()==falso)haga
      info=objc.Pop()
      Texto=Texto+Info
      objca.Push(Info)
   Fin_Mientras
   DevolverAux(objca,objc)
   retornar Texto
  FinMetodo


  publico vacio DevolverAux(Cola objca, Cola objc)
   mientras(objca.IsEmpty()==falso)
     objc.Push(objca.Pop())
   Fin_Mientras
  FinMetodo


  publico booleano Buscar (Cola c1,Cola c2,entero cod)
     booleano sw=falso
     Estudiante info
     mientras(c1.IsEmpty()==falso)haga
      info=(Estudiante)c1.Pop()
       Si(info.obtenerCod()== cod)entonces
         sw = verdadero
       FinSi
       c2.Push(info)
     FinMientras
    DevolverAux(c2,c1)
    retornar sw
  FinMetodo


  publico Objeto Eliminar (Cola c1,Cola c2,entero cod)
    Objeto est = nulo
    Estudiante info
    mientras(c1.IsEmpty()==falso)haga
       info=(Estudiante)c1.Pop()
        Si(info.obtenerCod()== cod))entonces
          est = info
         sino
          c2.Push(info)
        Fin_Si
    Fin_Mientras
    DevolverAux(c2,c1)
    retornar est
  FinMetodo


  publico Objeto Consultar(Cola c1, Cola c2,entero cod)
    Objeto est = nulo
    Estudiante info
    mientras(c1.IsEmpty()==falso)
      info =(Estudiante)c1.Pop()
      Si(info.obtenerCod() == cod)entonces
        est = info
      Fin_Si
      c2.Push(info)
    Fin_Mientras
    DevolverAux(c2,c1)
    retornar est
  FinMetodo


  publico vacio actualizarNotaDef(Cola objCola, Cola objCAux, entero cod)
     double notaDef
     booleano flag = falso
     Estudiante info
     mientras(objCola.IsEmpty()==falso)haga
      info = (Estudiante)objCola.Pop()
      si(info.getCod() == cod)entonces
        flag  = verdadero
        imprimir(" ingrese la nueva nota definitiva del estudiante: ")
        notaDef = sc.nextDouble()
        info.setNotaDef(notaDef)
        imprimir("La nota del estudiante fue actualizados exitosamente")
        objPAux.Push(info)
        roimper
      Fin_Si
      objCAux.Push(info)
     Fin_Mientras
     si(flag==falso)entonces
       imprimir("**El código del estudiante no existe en la pila\n")
     Fin_Si
     retornoPilaAux(objPila, objPAux)
   FinMetodo
FinClase
